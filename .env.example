# Copy to .env.local for local development; set the same names in Vercel (Project → Settings → Environment Variables).

# n8n webhook that receives enquiries from the contact form. Server only, never exposed to the browser.
ENQUIRY_WEBHOOK_URL=

# Google Analytics 4 measurement ID. Placeholder until the property exists; analytics stays off while it is.
# Set the real ID for Production only, so previews and local dev send no analytics.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Optional ownership tags for Google Search Console (the content of google-site-verification) and
# Bing Webmaster Tools (the content of msvalidate.01). Not needed if the domain is verified by DNS.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
