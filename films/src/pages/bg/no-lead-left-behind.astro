---
import Film from '../../layouts/Film.astro';
import Reveal from '../../components/Reveal.astro';
import Icon from '../../components/Icon.astro';
import SystemMap from '../../components/SystemMap.astro';
import MiniMap from '../../components/MiniMap.astro';
import { getEntry, getGraph, nodeByName } from '../../lib/data';
import { regions } from '../../lib/regions';
import film from '../../data/generated/sales.film.json';
import shot from '../../assets/shots/sales-pipeline.png';

const g = getGraph('sales-pipeline');

// Bulgarian edition: the same machine and data, a Bulgarian lead, and the messages translated.
const LEAD = 'Георги';
const remindersBg = [
  { subject: 'Време е да промениш живота си…', sms: 'Здравей, Георги! Време е да поемеш живота си в свои ръце. Ще ти покажа как в четвъртък в 14:00.' },
  { subject: 'Ето всичко предварително.', sms: 'Здравей, Георги! Пратих ти нещо по имейла. Мисля, че ще ти хареса.' },
  { subject: 'Днес е денят…', sms: 'Георги, днес е денят. След пет години ще си спомняш за него…' },
  { subject: 'Времето тече…', sms: 'Георги, срещата ни е след 5 часа. Готов съм.' },
  { subject: 'Време е…', sms: 'Георги, време е. Срещата ни е след 10 минути!' },
];
const rescueBg = [
  { subject: 'Пропусна срещата, Георги…' },
  { subject: 'Само ти спираш себе си.' },
  { subject: 'Какво чакаш?!' },
  { subject: 'Кога ще ти омръзне да стоиш на едно място?' },
  { subject: 'Шансът ти изтича…' },
  { subject: 'Това е последният ти шанс…' },
];
if (remindersBg.length !== film.reminders.length || rescueBg.length !== film.rescue.length) throw new Error('Message count moved');
const gapBg = (gap: string | null) => (gap ? gap.replace(/^1 day$/, '1 ден').replace(/ days$/, ' дни') : '');
const statusBg: Record<string, string> = { confirmed: 'потвърдена' };
const e = getEntry('sales-pipeline');

// Each CRM webhook starts its own sequence: everything reachable from it.
const next = new Map<string, string[]>();
for (const ed of g.edges) next.set(ed.from, [...(next.get(ed.from) ?? []), ed.to]);
const reach = (start: string) => {
  const seen = new Set([nodeByName(g, start).id]);
  const queue = [...seen];
  while (queue.length) for (const to of next.get(queue.shift()!) ?? []) if (!seen.has(to)) { seen.add(to); queue.push(to); }
  return g.nodes.filter((n) => seen.has(n.id) && n.type !== 'lmChatOpenAi').map((n) => n.name);
};
const booked = reach('Webhook1');
const missed = reach('Webhook');
const quiet = reach('Webhook2');
// The booking itself (confirm), then the timed reminders after it.
const confirmNames = ['Webhook1', 'Edit Fields', 'format apt dateTime', 'code1', 'subject, body 7', 'send email from GHL 7', 'GHL Add Note 8', 'If phnbr exists', 'send SMS from GHL 8', 'GHL Add Note 14', 'Update Sequence Number5'];
const R = regions(g, [
  ['Записан', confirmNames],
  ['Напомняне', booked.filter((n) => !confirmNames.includes(n))],
  ['Спасяване', missed],
  ['Връщане', quiet],
], 10);
const tools = regions(g, [['Booked', booked], ['No-show', missed], ['Gone quiet', quiet]], 10);
const toolLabels = [
  { step: 'Booked', title: '1 · Записа се', sub: 'потвърждение + 4 напомняния', place: 'above' as const },
  { step: 'No-show', title: '2 · Не дойде', sub: 'до 6 съобщения, докато се запише', place: 'above' as const },
  { step: 'Gone quiet', title: '3 · Изчезна', sub: 'намира стари клиенти отново', place: 'below' as const },
];

// The happy path through the reminders, lit in the reveal.
const path: string[] = [];
for (let id: string | undefined = nodeByName(g, 'Webhook1').id; id && !path.includes(id); ) {
  path.push(id);
  id = g.edges.find((ed) => ed.from === id && ed.port === 0 && !ed.ai)?.to;
}

// Confirm: where each reminder sits on a 48-hour runway.
const span = 48 * 60;
const marks = [
  { at: 'now', label: 'веднага', x: 0, key: 'now' },
  ...(film.offsets as [string, number][]).map(([, min], i) => ({ at: `${min >= 60 ? min / 60 + ' ч' : min + ' мин'}`, label: `${min >= 60 ? min / 60 + ' ч' : min + ' мин'} преди`, x: ((span - (min as number)) / span) * 100, key: String(i) })),
];
const whenLabel = ['веднага', ...film.offsets.map(([, m]) => `${(m as number) >= 60 ? (m as number) / 60 + ' ч' : m + ' мин'} преди`)];

// Rescue: the lead rebooks after the third message (invented for the film).
const REBOOK_AFTER = 3;
// Revive: invented leads, run through the real filters. `days` feeds the live 3-week rule.
const LEADS = [
  { n: 'Мария Р.', tag: 1, email: 1, dnd: 0, bad: 0, days: 46 },
  { n: 'Тони К.', tag: 1, email: 1, dnd: 0, bad: 0, days: 9 },
  { n: 'Ана Л.', tag: 1, email: 0, dnd: 0, bad: 0, days: 80 },
  { n: 'Ники П.', tag: 1, email: 1, dnd: 1, bad: 0, days: 33 },
  { n: 'Любо С.', tag: 1, email: 1, dnd: 0, bad: 1, days: 52 },
  { n: 'Зори М.', tag: 0, email: 1, dnd: 0, bad: 0, days: 120 },
  { n: 'Ели Й.', tag: 1, email: 1, dnd: 0, bad: 0, days: 63 },
  { n: 'Сашо В.', tag: 1, email: 1, dnd: 0, bad: 0, days: 28 },
];
const checks = (l: (typeof LEADS)[number]) => [l.tag === 1, l.email === 1, l.dnd === 0, l.bad === 0];
const failAt = (l: (typeof LEADS)[number]) => { const i = checks(l).indexOf(false); return i < 0 ? 4 : i; };
const cols = ['стар клиент', 'има имейл', 'приема съобщения', 'без забрани', 'мълчи 3+ седм.'];
const colT = (k: number) => 0.1 + k * 0.1;

const liveSource = film.live;
const liveFixtures = { quietDays: LEADS.map((l) => l.days) };

const STEPS = R.map((r) => r.step);
const SCENES = [
  ['open', 130], ['problem', 280], ['fix', 300],
  ['booked', 300, 'Записан'], ['remind', 320, 'Напомняне'], ['rescue', 340, 'Спасяване'], ['revive', 320, 'Връщане'],
  ['machine', 280], ['end', 150],
] as const;
const io = (a: number, b: number, c = 2, dd = 2) => `--a:${a};--b:${b};--c:${c};--d:${dd}`;
const crm = [['Мария Р.', '2 дни'], ['Тони К.', '9 дни'], ['Ана Л.', '23 дни'], ['Ники П.', '41 дни'], ['Любо С.', '68 дни'], ['Зори М.', '95 дни'], ['Ели Й.', '130 дни']];
---
<Film
  title="Без забравени клиенти · Orryvelle"
  film="Без забравени клиенти"
  description="Кратък филм за система, която потвърждава всяка среща, търси всеки, който не е дошъл, и връща забравените клиенти."
  runtime={150}
  steps={STEPS}
  lang="bg"
>
  <div class="stage">
    <section class="layer hold-start on" id="open">
      <div class="center">
        <div class="o-wrap">
          <h1 class="title-x o-title" style="view-transition-name: film-title; --em: 18.8; --em-m: 11.9"><span>Без забравени</span> <span>клиенти</span></h1>
          <p class="narr io" style={io(0.25, 0.4)}>Кратък филм за система, която не забравя нито един клиент.</p>
          <p class="invented io" style={io(0.4, 0.55)}>Хората са измислени. Системата е истинска.</p>
        </div>
      </div>
      <p class="cue">Превъртете, за да започне</p>
    </section>

    <!-- The problem -->
    <section class="layer" id="problem">
      <p class="kicker io" style={io(0.02, 0.08)}>Проблемът</p>
      <div class="center safe">
        <div class="pb">
          <div class="cal in" style={io(0.04, 0.1)}>
            <p class="cal-h">Четвъртък</p>
            {['13:00', '14:00', '15:00'].map((h) => (
              <div class="hour"><time>{h}</time>
                {h === '14:00' && (
                  <div class="slot-wrap">
                    <p class="slot io" style={io(0.08, 0.14, 0.28, 0.32)}><b>Първа среща</b><span>{LEAD}</span></p>
                    <p class="slot gone in" style={io(0.3, 0.34)}><b>Първа среща</b><span>✕ не дойде</span></p>
                  </div>
                )}
              </div>
            ))}
          </div>
          <div class="crm">
            <p class="who in" style={io(0.4, 0.44)}>Вашите клиенти · последен разговор</p>
            {crm.map(([n, d], i) => (
              <p class="crm-r in" style={`${io(0.42 + i * 0.02, 0.46 + i * 0.02)};--cold:${i / (crm.length - 1)}`}><span>{n}</span><b>преди {d}</b></p>
            ))}
          </div>
        </div>
      </div>
      <div class="subs">
        <p class="narr io" style={io(0.04, 0.1, 0.34, 0.38)}>Хората си записват среща. После нещо им се случва и не идват.</p>
        <p class="narr io" style={io(0.42, 0.48, 0.93, 0.97)}>Никой не им пише отново. Старите клиенти просто се забравят.</p>
      </div>
    </section>

    <!-- The fix -->
    <section class="layer" id="fix">
      <p class="kicker io" style={io(0.02, 0.08)}>Решението · истинската система</p>
      <div class="center safe">
        <div class="fixmap"><SystemMap graph={g} regions={tools} labels={toolLabels} start={0.14} gap={0.12} boxes={false} fs={200} /></div>
      </div>
      <div class="subs">
        <p class="narr io" style={io(0.04, 0.1, 0.5, 0.56)}>Една програма следи списъка с клиенти за три неща.</p>
        <p class="narr io" style={io(0.6, 0.66, 0.93, 0.97)}>Записал се, не дошъл или изчезнал. За всяко има своя поредица съобщения.</p>
      </div>
    </section>

    <!-- 1 · Confirm: one clock, exact times -->
    <section class="layer" id="booked">
      <div class="center safe">
        <div class="cf">
          <div class="cf-top">
            <div class="evt in" style={io(0.02, 0.08)}><p class="who">Нова среща · от списъка с клиенти</p><p class="ev-t">{LEAD} · първа среща</p><p class="ev-s">след 48 часа · местно време</p></div>
            <svg class="arr" viewBox="0 0 100 20" preserveAspectRatio="none" aria-hidden="true"><path class="draw" pathLength="1" d="M0 10 H100" style={io(0.1, 0.16)} /></svg>
            <p class="ai in hit" style={io(0.14, 0.2)}><Icon name="verdict" /><b>AI агент</b><span>{film.model}</span></p>
            <svg class="arr" viewBox="0 0 100 20" preserveAspectRatio="none" aria-hidden="true"><path class="draw" pathLength="1" d="M0 10 H100" style={io(0.2, 0.26)} /></svg>
            <p class="iso in" style={io(0.24, 0.3)}><code data-sched="iso">…</code><small>един общ часовник · UTC</small></p>
          </div>
          <div class="runway">
            <i class="bar grow" style={io(0.32, 0.6)}></i>
            {marks.map((m, i) => (
              <div class:list={['mk in', { low: i === marks.length - 1 }]} style={`${io(0.34 + i * 0.06, 0.38 + i * 0.06)};--x:${m.x}%`}>
                <b class="hit-text">{m.label}</b><span data-sched={m.key}>…</span>
              </div>
            ))}
            <i class="end-dot in" style={io(0.62, 0.68)}></i>
            <div class="mk appt in" style={io(0.62, 0.68)}><b>срещата</b><span data-sched="appt">…</span></div>
          </div>
          <ol class="sched-list">
            {marks.map((m, i) => <li class="in" style={io(0.34 + i * 0.06, 0.38 + i * 0.06)}><b>{m.label}</b><span data-sched={m.key}>…</span></li>)}
            <li class="call in" style={io(0.62, 0.68)}><b>срещата</b><span data-sched="appt">…</span></li>
          </ol>
          <p class="stamp in" style={io(0.66, 0.72)}>Истинският код на програмата току-що изчисли часовете в браузъра ви · <b data-live="sched-ms">…</b></p>
        </div>
      </div>
      <div class="subs">
        <p class="narr io" style={io(0.04, 0.1, 0.46, 0.5)}>Някой си записва среща. AI превръща часа ѝ в точно време.</p>
        <p class="narr io" style={io(0.54, 0.6, 0.93, 0.97)}>После програмата сама решава кога да прати всяко напомняне.</p>
      </div>
    </section>

    <!-- 2 · Remind: five messages, each one checked first -->
    <section class="layer" id="remind">
      <div class="center safe">
        <div class="rm">
          <ol class="rm-row">
            {remindersBg.map((r, i) => (
              <li class="rm-c in" style={io(0.06 + i * 0.1, 0.12 + i * 0.1)}>
                <p class="rm-when">{whenLabel[i]}</p>
                {i > 0 ? (
                  <p class="gate in" style={io(0.09 + i * 0.1, 0.13 + i * 0.1)}><span>✓ още е {statusBg[film.confirmCheck[0]] ?? film.confirmCheck[0]}</span><span>✓ часът не е сменен</span></p>
                ) : (
                  <p class="gate first"><span>щом се запише</span></p>
                )}
                <p class="subj"><Icon name="reply" />{r.subject}</p>
                <p class="sms">{r.sms}</p>
              </li>
            ))}
          </ol>
          <p class="chips">
            <span class="chip in" style={io(0.6, 0.64)}>SMS само ако има телефон</span>
            <span class="chip in" style={io(0.64, 0.68)}>записа се за по-малко от 24 ч? първите се пропускат</span>
            <span class="chip hot in hit" style={io(0.7, 0.74)}>премести или отказа срещата → спира</span>
          </p>
        </div>
      </div>
      <div class="subs">
        <p class="narr io" style={io(0.04, 0.1, 0.5, 0.56)}>Пет напомняния, всяко в точния момент преди срещата.</p>
        <p class="narr io" style={io(0.6, 0.66, 0.93, 0.97)}>Преди всяко проверява дали срещата още е в сила.</p>
      </div>
    </section>

    <!-- 3 · Rescue: the no-show ladder -->
    <section class="layer" id="rescue">
      <div class="center safe">
        <div class="rs">
          <ol class="ladder">
            {rescueBg.map((m, i) => {
              const sent = i < REBOOK_AFTER;
              const a = 0.06 + i * 0.09;
              return (
                <li class:list={['rung in', { unsent: !sent }]} style={io(a, a + 0.05)}>
                  <p class="r-n">{i + 1}</p>
                  <p class="r-s">{m.subject}</p>
                  {!sent && <p class="r-x">не се праща</p>}
                  {i < rescueBg.length - 1 && (
                    <p class:list={['wait in', { stop: i === REBOOK_AFTER - 1 }]} style={io(a + 0.04, a + 0.08)}>
                      <span>{film.gaps[i] ? `изчаква ${gapBg(film.gaps[i])}` : 'изчаква'}</span>
                      <b>{i === REBOOK_AFTER - 1 ? 'записа се → спира' : 'не се записа → следващо'}</b>
                    </p>
                  )}
                </li>
              );
            })}
          </ol>
          <p class="saved in hit" style={io(0.36, 0.42)}><b>Записа се отново</b><span>бележка в списъка · клиентът е спасен · съобщенията спират</span></p>
          <p class="chips"><span class="chip in" style={io(0.5, 0.54)}>записан = статус “{film.booked.join('” или “')}”</span></p>
        </div>
      </div>
      <div class="subs">
        <p class="narr io" style={io(0.04, 0.1, 0.46, 0.5)}>Не дойде? Програмата не се отказва. До шест съобщения за три седмици.</p>
        <p class="narr io" style={io(0.54, 0.6, 0.93, 0.97)}>Щом човекът си запише нов час, съобщенията спират.</p>
      </div>
    </section>

    <!-- 4 · Revive: the old leads -->
    <section class="layer" id="revive">
      <div class="center safe">
        <div class="rv">
          <div class="mx" role="table" aria-label="Старите клиенти минават през проверките">
            <p class="mx-r mx-h" role="row"><span role="columnheader">клиент</span>{cols.map((c) => <span role="columnheader">{c}</span>)}</p>
            {LEADS.map((l, li) => {
              const f = failAt(l);
              return (
                <p class="mx-r" role="row" data-pre={f === 4 ? '1' : '0'} style={`--f:${colT(f) + 0.08}`}>
                  <span role="cell">{l.n}</span>
                  {checks(l).map((ok, k) => (
                    <span role="cell" class:list={['in', { no: !ok, skip: k > f }]} style={io(colT(k) + li * 0.006, colT(k) + 0.04 + li * 0.006)}>{k > f ? '·' : ok ? '✓' : '✕'}</span>
                  ))}
                  <span role="cell" class:list={['in q', { skip: f < 4 }]} style={io(colT(4) + li * 0.006, colT(4) + 0.04 + li * 0.006)} data-quiet={f === 4 ? li : undefined}>{f < 4 ? '·' : '…'}</span>
                </p>
              );
            })}
          </div>
          <p class="handoff in hit" style={io(0.62, 0.68)}>→ <b>{film.handoff.replace('1st Sequence', '1-ва поредица')}</b><span>които минат всички проверки, получават нови съобщения</span></p>
          <p class="stamp in" style={io(0.66, 0.72)}>Правилото за 3 седмици току-що се изпълни в браузъра ви · <b data-live="quiet-ms">…</b></p>
        </div>
      </div>
      <div class="subs">
        <p class="narr io" style={io(0.04, 0.1, 0.5, 0.56)}>А клиентите, които всички забравиха? Програмата сама ги търси.</p>
        <p class="narr io" style={io(0.6, 0.66, 0.93, 0.97)}>Пише само на тези, които приемат съобщения и мълчат от три седмици.</p>
      </div>
    </section>

    <Reveal id="machine" graph={g} shot={shot} title="Без забравени клиенти" facts={[`${e.stats.nodes} стъпки`, `${film.triggers} повода`, `${film.emails + film.sms} съобщения`, '1 AI агент']} path={path} />

    <section class="layer hold-end" id="end">
      <div class="center">
        <div class="end">
          <p class="fin">— Край —</p>
        </div>
      </div>
    </section>
  </div>

  <MiniMap graph={g} regions={R} />

  <div class="track" aria-hidden="true">
    {SCENES.map(([id, len, ch]) => <div data-scene={id} data-chapter={ch} style={`--len:${len}`}></div>)}
  </div>
  <script type="application/json" id="live-source" set:html={JSON.stringify(liveSource)} />
  <script type="application/json" id="live-fixtures" set:html={JSON.stringify(liveFixtures)} />
</Film>

<style>
  .stamp { text-align: center; }

  /* The problem */
  .pb { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 96px); align-items: center; width: min(920px, 100%); }
  .cal { padding: 16px 18px; background: var(--night-2); border: 1px solid var(--line); border-radius: 10px; display: grid; gap: 0; }
  .cal-h { font-size: 0.68rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-3); padding-bottom: 10px; }
  .hour { display: grid; grid-template-columns: 3.4em 1fr; gap: 12px; min-height: 64px; border-top: 1px solid #1f2227; padding-top: 6px; }
  .hour time { font-family: var(--mono); font-size: 0.72rem; color: var(--text-3); }
  .slot-wrap { display: grid; }
  .slot { grid-area: 1 / 1; display: grid; gap: 2px; padding: 8px 12px; border-radius: 6px; border-left: 3px solid var(--live); background: rgb(255 107 61 / 0.12); }
  .slot b { font-weight: 500; font-size: 0.95rem; }
  .slot span { font-size: 0.78rem; color: var(--text-2); }
  .slot.gone { border-left-color: #4a4d55; background: #15171b; }
  .slot.gone b { color: var(--text-3); text-decoration: line-through; }
  .slot.gone span { color: var(--live); font-family: var(--mono); font-size: 0.72rem; }
  .crm { display: grid; gap: 4px; }
  .crm-r { --k: clamp(0, (var(--p) - 0.55 - var(--cold) * 0.12) / 0.1, 1); display: flex; justify-content: space-between; padding: 8px 10px; border-bottom: 1px solid #1d2025; font-size: 0.92rem; }
  .crm-r span { color: color-mix(in srgb, #4a4d55 calc(var(--k) * var(--cold) * 100%), var(--text)); }
  .crm-r b { font-family: var(--mono); font-weight: 400; font-size: 0.76rem; color: color-mix(in srgb, #4a4d55 calc(var(--k) * var(--cold) * 100%), var(--text-2)); }

  .fixmap { width: min(1100px, 100%); }

  /* Confirm */
  .cf { display: grid; gap: clamp(36px, 7vh, 64px); width: min(1060px, 100%); }
  .cf-top { display: grid; grid-template-columns: minmax(0, 1fr) 50px auto 50px minmax(0, 1fr); gap: 12px; align-items: center; }
  .evt { padding: 14px 16px; background: var(--night-2); border: 1px solid var(--line); border-radius: 10px; display: grid; gap: 4px; }
  .ev-t { font-size: 1.05rem; font-weight: 500; }
  .ev-s { font-family: var(--mono); font-size: 0.72rem; color: var(--text-3); }
  .arr { width: 100%; height: 20px; overflow: visible; }
  .arr path { stroke: var(--live); stroke-width: 2; vector-effect: non-scaling-stroke; fill: none; }
